# Copy to .env (which git ignores) and fill in. Leave blank to turn email off.
# Gmail: turn on 2-Step Verification, then create an App Password for "Mail".
DISCLOSURE_SMTP_HOST=smtp.gmail.com
DISCLOSURE_SMTP_PORT=587
DISCLOSURE_SMTP_USER=you@gmail.com
DISCLOSURE_SMTP_PASSWORD=your-16-letter-app-password
DISCLOSURE_SMTP_FROM=you@gmail.com

# Model server. Leave unset for Ollama on this computer.
# For the Cloud Run GPU service (see cloud/README.md), run the proxy and set:
# DISCLOSURE_OLLAMA_URL=http://127.0.0.1:9090
# DISCLOSURE_MODEL=gemma4:e4b
# DISCLOSURE_WORKERS=4
# DISCLOSURE_OLLAMA_TOKEN=   # only for a direct IAM token; empty when using the proxy

# Optional TypeSafe (Jev) text judge. Leave DISCLOSURE_TYPESAFE_URL empty to keep it off.
# Only Gemma's one-sentence reason, title and typed fields are sent; never photos.
# DISCLOSURE_TYPESAFE_URL=
# TYPESAFE_API_KEY=
# DISCLOSURE_TYPESAFE_MODEL=jev-latest
# DISCLOSURE_JUDGE_VERIFY=1     # second opinion on each finding
# DISCLOSURE_JUDGE_CLASSIFY=1   # Jev picks the defect type and confidence (new Gemma prompt v4)
# DISCLOSURE_JUDGE_YES=0.7
# DISCLOSURE_JUDGE_NO=0.3
